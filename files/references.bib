  keywords = {Algorithms,Behavior,Data Interpretation Statistical,Electroencephalography,Evoked Potentials,Face,Humans,Image Processing Computer-Assisted,Individuality,Linear Models,Observer Variation,Psychomotor Performance,Reproducibility of Results,Visual Perception},
