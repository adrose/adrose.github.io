  volume = {28},
  number = {3},
  pages = {213--237},
  issn = {0160-2896},
  doi = {10.1016/S0160-2896(00)00037-4},
  url = {https://www.sciencedirect.com/science/article/pii/S0160289600000374},
  urldate = {2021-06-15},
  abstract = {This study investigated the differences in cognitive processes related to creativity and intelligence using EEG coherence and power measures in the lower (α1=7.9–10.0 Hz) and upper alpha band (α2=10.1–12.9 Hz). In two experiments, gifted, creative, intelligent subjects, and individuals of average ability solved closed and open problems while their EEG was recorded. The analysis of EEG measures in Experiment 1 indicated that highly intelligent individuals (HIQ—gifted and intelligent) showed higher alpha power (less mental activity) and more cooperation between brain areas when solving closed problems than did average intelligent individuals (AIQ—creative and average). Much more pronounced were the differences in EEG patterns obtained in Experiment 2. Highly creative individuals (HC—gifted and creative) displayed less mental activity than did average creative individuals (AC—intelligent and average) when engaged in the solution of different creative problems. Creative individuals also showed more cooperation between brain areas than did gifted ones, who showed greater decoupling of brain areas when solving ill-defined problems. The results of both experiments suggest that creativity and intelligence are different abilities that also differ in the neurological activity displayed by individuals while solving open or closed problems. The results further suggest that a selective involvement of cortical zones that are relevant for the solution of a problem could be an explanation for the observed differences in problem solving.},
  langid = {english},
  file = {/home/arosen/Zotero/storage/LE37CDDC/Jaušovec - 2000 - Differences in Cognitive Processes Between Gifted,.pdf;/home/arosen/Zotero/storage/IDQRJ7LA/S0160289600000374.html}
}

@article{jenningsComparingPrePostChange2016,
  title = {Comparing {{Pre-Post Change Across Groups}}: {{Guidelines}} for {{Choosing}} between {{Difference Scores}}, {{ANCOVA}}, and {{Residual Change Scores}}},
  shorttitle = {Comparing {{Pre-Post Change Across Groups}}},
  author = {Jennings, Megan A. and Cribbie, Robert A.},
  date = {2016-04-01},
  journaltitle = {Journal of Data Science},
  volume = {14},
  number = {2},
  pages = {205--229},
  doi = {10.6339/JDS.201604_14(2).0002},
  url = {https://www.airitilibrary.com/Article/Detail/16838602-201604-201606240005-201606240005-205-229},
  urldate = {2025-06-16},
  abstract = {Psychological researchers often investigate differences between groups in the amount of change from pre-test to post-test. For example, researchers treating a group of depressed students may wish to compare the amount of improvement from pre-intervention to post-intervention for males and females, or the researchers may randomly assign participants to groups and compare their improvement across two treatments. In the first case, there are likely to be pre-test differences between the groups, whereas in the second case no pre-test group differences are expected. Three of the most popular methods for comparing independent groups with regard to the amount of change are difference scores, ANCOVA, and residualized change scores. Although the choice between these methods is sometimes clear, in most instances this is not the case. In this research, a simulation study was used to determine the effect of many common issues on the bias, Type I error rates, and power of the difference score, ANCOVA, and residual change score. These issues included: sample size, reliability of the measure, floor/ceiling effects, effect size, and baseline group differences. Results from the study are used to provide specific recommendations with regards to applying each of these three methods.},
  file = {/home/arosen/Zotero/storage/662LZI4P/Jennings and Cribbie - 2016 - Comparing Pre-Post Change Across Groups Guidelines for Choosing between Difference Scores, ANCOVA,.pdf;/home/arosen/Zotero/storage/TLMTBK3C/16838602-201604-201606240005-201606240005-205-229.html}
}

