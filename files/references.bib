@article{aksudunyaPsychometricPropertiesDifferential2020,
  title = {Psychometric {{Properties}} and {{Differential Item Functioning}} of a {{Web-Based Assessment}} of {{Children}}’s {{Emotion Recognition Skill}}},
  author = {Aksu Dunya, Beyza and McKown, Clark and Smith, Everett},
