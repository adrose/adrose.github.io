@article{delormeEEGLABOpenSource2004,
  title = {{{EEGLAB}}: An Open Source Toolbox for Analysis of Single-Trial {{EEG}} Dynamics Including Independent Component Analysis},
  shorttitle = {{{EEGLAB}}},
  author = {Delorme, Arnaud and Makeig, Scott},
