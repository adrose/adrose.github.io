@article{kimEstimationIRTReliability2010,
  title = {The Estimation of the {{IRT}} Reliability Coefficient and Its Lower and Upper Bounds, with Comparisons to {{CTT}} Reliability Statistics},
  author = {Kim, Seonghoon and Feldt, Leonard S.},
  date = {2010-06-01},
