@article{brandmaierOptimalPlannedMissing2020,
  title = {Optimal Planned Missing Data Design for Linear Latent Growth Curve Models},
  author = {Brandmaier, Andreas M. and Ghisletta, Paolo and family=Oertzen, given=Timo, prefix=von, useprefix=false},
