  file = {/home/arosen/Zotero/storage/K9LIT6WX/Ciric et al. - 2018 - Mitigating head motion artifact in functional conn.pdf;/home/arosen/Zotero/storage/3JEJTWVR/s41596-018-0065-y.html}
}

