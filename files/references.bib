@article{jirsaraieAcceleratedCorticalThinning2019,
  title = {Accelerated Cortical Thinning within Structural Brain Networks Is Associated with Irritability in Youth},
  author = {Jirsaraie, Robert J. and Kaczkurkin, Antonia N. and Rush, Sage and Piiwia, Kayla and Adebimpe, Azeez and Bassett, Danielle S. and Bourque, Josiane and Calkins, Monica E. and Cieslak, Matthew and Ciric, Rastko and Cook, Philip A. and Davila, Diego and Elliott, Mark A. and Leibenluft, Ellen and Murtha, Kristin and Roalf, David R. and Rosen, Adon F. G. and Ruparel, Kosha and Shinohara, Russell T. and Sotiras, Aristeidis and Wolf, Daniel H. and Davatzikos, Christos and Satterthwaite, Theodore D.},
  date = {2019-12},
  journaltitle = {Neuropsychopharmacology},
  shortjournal = {Neuropsychopharmacol.},
  volume = {44},
  number = {13},
  pages = {2254--2262},
  publisher = {Nature Publishing Group},
  issn = {1740-634X},
  doi = {10.1038/s41386-019-0508-3},
  url = {https://www.nature.com/articles/s41386-019-0508-3},
  urldate = {2025-06-22},
  abstract = {Irritability is an important dimension of psychopathology that spans multiple clinical diagnostic categories, yet its relationship to patterns of brain development remains sparsely explored. Here, we examined how transdiagnostic symptoms of irritability relate to the development of structural brain networks. All participants (n\,=\,137, 83 females) completed structural brain imaging with 3 Tesla MRI at two timepoints (mean age at follow-up: 21.1 years, mean inter-scan interval: 5.2 years). Irritability at follow-up was assessed using the Affective Reactivity Index, and cortical thickness was quantified using Advanced Normalization Tools software. Structural covariance networks were delineated using non-negative matrix factorization, a multivariate analysis technique. Both cross-sectional and longitudinal associations with irritability at follow-up were evaluated using generalized additive models with penalized splines. The False Discovery Rate (q\,{$<$}\,0.05) was used to correct for multiple comparisons. Cross-sectional analysis of follow-up data revealed that 11 of the 24 covariance networks were associated with irritability, with higher levels of irritability being associated with thinner cortex. Longitudinal analyses further revealed that accelerated cortical thinning within nine networks was related to irritability at follow-up. Effects were particularly prominent in brain regions implicated in emotion regulation, including the orbitofrontal, lateral temporal, and medial temporal cortex. Collectively, these findings suggest that irritability is associated with widespread reductions in~cortical thickness and accelerated cortical thinning, particularly within the~frontal and temporal cortex. Aberrant structural maturation of regions important for emotional regulation may in part underlie symptoms of irritability.},
  langid = {english},
  keywords = {Predictive markers,Prefrontal cortex},
  file = {/home/arosen/Zotero/storage/YB596J5I/Jirsaraie et al. - 2019 - Accelerated cortical thinning within structural brain networks is associated with irritability in yo.pdf}
}

