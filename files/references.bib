}

@article{zumboDialecticValidityExplanationfocused2023,
  title = {A Dialectic on Validity: {{Explanation}}-Focused and the Many Ways of Being Human},
  shorttitle = {A Dialectic on Validity},
  author = {Zumbo, Bruno D.},
  date = {2023-12-27},
  journaltitle = {International Journal of Assessment Tools in Education},
