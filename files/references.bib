@article{larsonMakingSenseAll2014,
  title = {Making Sense of All the Conflict: {{A}} Theoretical Review and Critique of Conflict-Related {{ERPs}}},
  shorttitle = {Making Sense of All the Conflict},
  author = {Larson, Michael J. and Clayson, Peter E. and Clawson, Ann},
  date = {2014-09-01},
