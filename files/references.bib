@article{tangTheatreImprovisationTraining2020,
  title = {Theatre Improvisation Training to Promote Social Cognition: {{A}} Novel Recovery-Oriented Intervention for Youths at Clinical Risk for Psychosis},
  shorttitle = {Theatre Improvisation Training to Promote Social Cognition},
  author = {Tang, Sunny X. and Seelaus, Kevin H. and Moore, Tyler M. and Taylor, Jerome and Moog, Carol and O’ Connor, David and Burkholder, Marla and Kohler, Christian G. and Grant, Paul M. and Eliash, Dvora and Calkins, Monica E. and Gur, Raquel E. and Gur, Ruben C.},
  date = {2020-04},
  journaltitle = {Early intervention in psychiatry},
  shortjournal = {Early Interv Psychiatry},
  volume = {14},
  number = {2},
  eprint = {31177635},
  eprinttype = {pubmed},
