}

@article{shirleyHiddenMarkovModels2010,
  title = {Hidden {{Markov}} Models for Alcoholism Treatment Trial Data},
  author = {Shirley, Kenneth E. and Small, Dylan S. and Lynch, Kevin G. and Maisto, Stephen A. and Oslin, David W.},
  date = {2010-03},
  journaltitle = {The Annals of Applied Statistics},
  volume = {4},
  number = {1},
  pages = {366--395},
