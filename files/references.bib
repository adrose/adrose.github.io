@article{hawtonRiskFactorsSuicide2013,
  title = {Risk Factors for Suicide in Individuals with Depression: {{A}} Systematic Review},
  shorttitle = {Risk Factors for Suicide in Individuals with Depression},
  author = {Hawton, Keith and Casañas i Comabella, Carolina and Haw, Camilla and Saunders, Kate},
  date = {2013-05-01},
  journaltitle = {Journal of Affective Disorders},
