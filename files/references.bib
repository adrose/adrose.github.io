@article{phillipsNeurobiologyEmotionPerception2003,
  title = {Neurobiology of Emotion Perception {{I}}: The Neural Basis of Normal Emotion Perception},
  shorttitle = {Neurobiology of Emotion Perception {{I}}},
  author = {Phillips, Mary L and Drevets, Wayne C and Rauch, Scott L and Lane, Richard},
  date = {2003-09-01},
  journaltitle = {Biological Psychiatry},
  shortjournal = {Biological Psychiatry},
