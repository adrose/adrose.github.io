@article{fokkemaResponseShiftsMental2013,
  title = {Response Shifts in Mental Health Interventions: An Illustration of Longitudinal Measurement Invariance},
  shorttitle = {Response Shifts in Mental Health Interventions},
  author = {Fokkema, Marjolein and Smits, Niels and Kelderman, Henk and Cuijpers, Pim},
  date = {2013-06},
