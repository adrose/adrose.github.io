  author = {Gur, Raquel E. and Moore, Tyler M. and Rosen, Adon F. G. and Barzilay, Ran and Roalf, David R. and Calkins, Monica E. and Ruparel, Kosha and Scott, J. Cobb and Almasy, Laura and Satterthwaite, Theodore D. and Shinohara, Russell T. and Gur, Ruben C.},
