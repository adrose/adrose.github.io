  issn = {1552-3497},
  doi = {10.1177/014662169401800304},
  abstract = {The reliability coefficient and the standard error of measurement in classical test theory are not properties of a specific test, but are attributed to both a specific test and a specific trait distribution. In latent trait models, or item response theory, the test information function (TIF) provides more precise local measures of accuracy in trait estimation than are available from the reliability coefficient. The reliability coefficient is still widely used, however, and is popular because of its simplicity. Thus, it is worthwhile to relate it to the TIF. In this paper, the reliability coefficient is predicted from the TIF, or 2 modified TIF formulas, and a specific trait distribution. Examples demonstrate the variability of the reliability coefficient across different trait distributions, and the results are compared with empirical reliability coefficients. Practical suggestions are given for making better use of the reliability coefficient. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  keywords = {Error of Measurement,Item Response Theory,Statistical Estimation,Test Reliability},
  file = {/home/arosen/Zotero/storage/C8X87W4R/Samejima - 1994 - Estimation of reliability coefficients using the test information function and its modifications.pdf;/home/arosen/Zotero/storage/2XBJIZK7/1995-39457-001.html}
