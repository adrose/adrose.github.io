@article{claysonStabilityPerformanceMonitoring2025,
  title = {Stability of Performance Monitoring with Prolonged Task Performance: {{A}} Study of Error-Related Negativity and Error Positivity},
  shorttitle = {Stability of Performance Monitoring with Prolonged Task Performance},
  author = {Clayson, Peter E. and Baldwin, Scott A. and Larson, Michael J.},
  date = {2025},
