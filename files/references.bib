@article{olveraastiviaAgesStagesQuestionnaire2017,
  title = {The {{Ages}} and {{Stages Questionnaire}}: {{Latent}} Factor Structure and Growth of Latent Mean Scores over Time},
  shorttitle = {The {{Ages}} and {{Stages Questionnaire}}},
  author = {Olvera Astivia, Oscar L. and Forer, Barry and Dueker, Gwenden L. and Cowling, Candace and Guhn, Martin},
  date = {2017-12-01},
  journaltitle = {Early Human Development},
  shortjournal = {Early Human Development},
