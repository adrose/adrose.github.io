@article{gurBrainActivationFacial2002,
  title = {Brain {{Activation}} during {{Facial Emotion Processing}}},
  author = {Gur, Ruben C. and Schroeder, Lee and Turner, Travis and McGrath, Claire and Chan, Robin M. and Turetsky, Bruce I. and Alsop, David and Maldjian, Joseph and Gur, Raquel E.},
