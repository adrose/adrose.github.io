@article{skowronMappingCardiacPhysiology2011,
  title = {Mapping {{Cardiac Physiology}} and {{Parenting Processes}} in {{Maltreating Mother}}–{{Child Dyads}}},
  author = {Skowron, Elizabeth A. and Loke, Eric and Gatzke-Kopp, Lisa M. and Cipriano-Essel, Elizabeth A. and Woehrle, Petra L. and Van Epps, John J. and Gowda, Anjali and Ammerman, Robert T.},
  date = {2011-10},
  journaltitle = {Journal of family psychology : JFP : journal of the Division of Family Psychology of the American Psychological Association (Division 43)},
