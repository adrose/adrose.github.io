  urldate = {2024-03-10},
  abstract = {The launch of the 5th version of the Diagnostic and Statistical Manual of Mental Disorders (DSM-5) has sparked a debate about the current approach to psychiatric classification. The most basic and enduring problem of the DSM is that its classifications are heterogeneous clinical descriptions rather than valid diagnoses, which hampers scientific progress. Therefore, more homogeneous evidence-based diagnostic entities should be developed. To this end, data-driven techniques, such as latent class- and factor analyses, have already been widely applied. However, these techniques are insufficient to account for all relevant levels of heterogeneity, among real-life individuals. There is heterogeneity across persons (p:for example, subgroups), across symptoms (s:for example, symptom dimensions) and over time (t:for example, course-trajectories) and these cannot be regarded separately. Psychiatry should upgrade to techniques that can analyze multi-mode (p-by-s-by-t) data and can incorporate all of these levels at the same time to identify optimal homogeneous subgroups (for example, groups with similar profiles/connectivity of symptomatology and similar course). For these purposes, Multimode Principal Component Analysis and (Mixture)-Graphical Modeling may be promising techniques.},
  eid = {1},
  langid = {english},
  file = {/home/arosen/Zotero/storage/PAN5FWXL/Wardenaar and de Jonge - 2013 - Diagnostic heterogeneity in psychiatry towards an.pdf}
}

@article{wattsAlcoholUseDisorder2023,
  title = {Alcohol Use Disorder Criteria Exhibit Different Comorbidity Patterns},
  author = {Watts, Ashley L. and Watson, David and Heath, Andrew C. and Sher, Kenneth J.},
  date = {2023},
  journaltitle = {Addiction},
  volume = {118},
  number = {8},
  pages = {1457--1468},
  issn = {1360-0443},
  doi = {10.1111/add.16121},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/add.16121},
  urldate = {2025-10-06},
  abstract = {Background and aims Alcohol use disorder is comorbid with numerous other forms of psychopathology, including externalizing disorders (e.g. conduct disorder) and, to a lesser extent, internalizing conditions (e.g. depression, anxiety). Much of the time, overlap among alcohol use disorder and other conditions is explored at the disorder level, assuming that criteria are co-equal indicators of other psychopathology, even though alcohol use disorder criteria span numerous varied domains. Emerging evidence suggests that there are symptom clusters within the construct of alcohol use disorder that relate differentially with important external criteria, including psychopathology and allied personality traits (e.g. impulsivity, novelty-seeking). The present study mapped individual alcohol use disorder criteria onto internalizing and externalizing dimensions. Design and participants We used multivariate and factor analytical modeling and data from two large nationally representative samples of past year drinkers (n = 25 604; 19 454). Setting United States. Measurements Psychopathology was assessed using the Alcohol Use Disorder and Associated Disabilities Interview Schedule, yielding alcohol use disorder criteria, internalizing diagnoses (i.e. major depressive disorder, dysthymia, social anxiety disorder, generalized anxiety disorder, specific phobia, agoraphobia and panic disorder) and externalizing diagnoses and symptoms (i.e. antisocial personality disorder, conduct disorder and three impulsivity items drawn from borderline personality disorder criteria). Alcohol consumption was assessed in terms of past-year drinking frequency, usual amount of alcohol consumed on drinking days, binge drinking frequency, intoxication frequency, and maximum number of drinks in a 24-hour period. Findings Four different patterns emerged. First, several alcohol use disorder criteria were relatively weakly associated with externalizing and internalizing. Secondly, withdrawal was associated with internalizing, but this association was not specific to distress. Thirdly, there was a general lack of specificity between alcohol use disorder criteria and narrower forms of internalizing, despite what might be predicted by modern models of addiction. Fourthly, recurrent use in hazardous situations reflected higher degrees of externalizing and lower internalizing liability. Conclusions Different symptom combinations appear to yield differential expressions of alcohol use disorder that are disorder-specific, or reflect broader tendencies toward externalizing, internalizing or both.},
  langid = {english},
  keywords = {alcohol use disorder,comorbidity,externalizing,heterogeneity,internalizing,symptoms},
  file = {/home/arosen/Zotero/storage/X5Y9KAR5/Watts et al. - 2023 - Alcohol use disorder criteria exhibit different comorbidity patterns.pdf;/home/arosen/Zotero/storage/5T6ETBU2/add.html}
}

@article{wattsCovariationHigherorderPsychopathology2026,
  title = {Covariation among Higher-Order Psychopathology Dimensions Is Driven by Nomorbidity and Not Comorbidity},
  author = {Watts, Ashley L. and Rosen, Adon F. G. and Greene, Ashley L. and King, Kevin M. and Meyer, Francisco A. C. and Trull, Timothy J. and Sher, Kenneth J. and Joyner, Keanan J.},
  date = {2026-10-01},
  journaltitle = {Nature Mental Health},
  shortjournal = {Nat. Mental Health},
  pages = {1--12},
  publisher = {Nature Publishing Group},
  issn = {2731-6076},
  doi = {10.1038/s44220-026-00727-0},
  url = {https://www.nature.com/articles/s44220-026-00727-0},
  urldate = {2026-10-06},
  abstract = {Emerging classification frameworks claim that covariation among psychopathology dimensions reflects comorbidity. We scrutinized this claim by applying Bayesian change point models to four waves of the Adolescent Brain Cognitive Development Study data (N\,=\,11,868 youths; 48\% female) and examined associations among higher-order psychopathology dimensions. Covariation between psychopathology dimensions was driven by nomorbidity, not comorbidity: we observed strong positive associations among psychopathology dimensions at relatively extreme low (asymptomatic) levels (for example, when three to five symptoms were endorsed) and weak positive associations at higher levels. For instance, at wave 1, a 1-point increase in internalizing was associated with a 32\% increase in externalizing at nearly asymptomatic levels (B\,=\,0.28), compared with only a 7\% increase at higher levels (B\,=\,0.07). These findings challenge existing assumptions about comorbidity in nonclinical samples, suggesting that covariation is more accurately explained by the absence of symptomatology rather than shared psychiatric conditions.},
  langid = {english},
  keywords = {Psychology,Signs and symptoms},
  file = {/home/arosen/Zotero/storage/5QWBYHK2/Watts et al. - 2026 - Covariation among higher-order psychopathology dimensions is driven by nomorbidity and not comorbidi.pdf}
}

@article{wattsIncludingAbstainersConflatesa,
  title = {Including Abstainers Conflates Substance Consumption and Substance Use Disorder},
  author = {Watts, Ashley L. and Sexton, Joseph F. and Rosen, Adon F. G. and Himes, Katie P. and Poore, Holly E. and Littlefield, Andrew and Palmer, Rohan H. C. and Brusco, Michael and Steinley, Douglas and Sher, Kenneth J.},
  journaltitle = {Addiction},
  volume = {n/a},
  number = {n/a},
  issn = {1360-0443},
  doi = {10.1111/add.70631},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/add.70631},
  urldate = {2026-11-24},
  abstract = {Aims This study addressed the implications of including substance abstainers in investigations of the epidemiology, structure and nature of substance use disorder (SUD). Design We first conducted a Monte Carlo simulation to quantify bias introduced when ‘structural zeros’ (all-zero response patterns consistent with non-exposure) are added to symptom data used to model SUD. We simulated two correlated latent SUD factors and varied the proportion of all-zero rows to estimate inflation in (1) the recovered correlation between disorders and (2) the apparent strength (variance explained in the indicators) and unidimensionality of latent SUD factors. We then illustrated the implications of the simulation results in secondary cross-sectional analyses of the National Epidemiologic Survey on Alcohol and Related Conditions (NESARC) wave 1 (2001–2002), directly comparing estimates including abstainers (i.e. symptom indicators structurally coded as 0 via interview skip patterns/nonuse) and excluding abstainers (restricting to exposed individuals reporting past-year use). Setting United States. Participants NESARC included 43 093 participants (57\% female, 57\% White, 19\% Black, 3\% Asian, 2\% American Indian/Native American, 19\% Hispanic or Latino) aged 18 years or older. Measurements Past-year Diagnostic and Statistical Manual of Mental Disorders, Fourth Edition (DSM-IV) SUD criteria/diagnoses [alcohol use disorder (AUD), cannabis use disorder (CUD), tobacco use disorder (TUD), opioid use disorder (OUD)] and consumption frequency were assessed using the Alcohol Use Disorder and Associated Disabilities Interview Schedule-IV (AUDADIS-IV). We examined: (1) associations between consumption frequency and SUD diagnosis; (2) dissociable validity profiles of consumption vs. SUD across 30 external validators spanning other substance use, mental disorders and psychosocial functioning; and (3) cross-SUD overlap and evidence for general addiction liability using latent variable models. Results In simulations, adding all-zero response patterns produced substantial upward bias in recovered cross-disorder associations and increased apparent unidimensionality, even when true associations were modest. In NESARC, abstention was common (e.g. 96.3\% for cannabis; 98.4\% for opioids). Consumption and SUD showed dissociable relationships with external validators, with consumption generally less indicative than SUD of dysfunction broadly construed. Including abstainers substantially strengthened the observed association between consumption and SUD, correlations between different SUDs (e.g. AUD–CUD correlation was higher when abstainers were included than when restricting to users of both substances) and often strengthened general SUD factors (i.e. loadings were higher). Summary Including abstainers in epidemiologic studies can conflate substance exposure/consumption with substance use disorder liability, inflate cross-substance use disorder associations and strengthen apparent evidence for general addiction liability. We recommend adopting designs and analyses that explicitly separate exposure from disorder conditional on exposure.},
  langid = {english},
  keywords = {abstainers,alcohol use disorder,comorbidity,epidemiology,polysubstance use,population-level data,substance use disorder},
  file = {/home/arosen/Zotero/storage/ATNVSPW6/Watts et al. - Including abstainers conflates substance consumption and substance use disorder.pdf;/home/arosen/Zotero/storage/YYPD6ZIT/add.html}
}

@article{webbHasCOVID19Pandemic2022,
  title = {Has the {{COVID-19}} Pandemic Influenced Suicide Rates Differentially According to Socioeconomic Indices and Ethnicity? {{More}} Evidence Is Needed Globally},
  shorttitle = {Has the {{COVID-19}} Pandemic Influenced Suicide Rates Differentially According to Socioeconomic Indices and Ethnicity?},
  author = {Webb, Roger T. and John, Ann and Knipe, Duleeka and Bojanić, Lana and Dekel, Dana and Eyles, Emily and Marchant, Amanda and Mughal, Faraz and Pirkis, Jane and Schmidt, Lena and Gunnell, David},
  date = {2022-10-11},
  journaltitle = {Epidemiology and Psychiatric Sciences},
  shortjournal = {Epidemiol Psychiatr Sci},
  volume = {31},
  eprint = {36217667},
  eprinttype = {pubmed},
  pages = {e72},
  issn = {2045-7960},
  doi = {10.1017/S2045796022000543},
  url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9579839/},
  urldate = {2023-02-09},
  abstract = {The COVID-19 pandemic has harmed many people's mental health globally. Whilst the evidence generated thus far from high-income countries regarding the pandemic's impact on suicide rates is generally reassuring, we know little about its influence on this outcome in lower- and middle-income countries or among marginalised and disadvantaged people. There are some signals for concern regarding the pandemic's potentially unequal impact on suicide rates, with some of the affected demographic subgroups and regions being at elevated risk before the pandemic began. However, the evidence-base for this topic is currently sparse, and studies conducted to date have generally not taken account of pre-pandemic temporal trends. The collection of accurate, complete and comparable data on suicide rate trends in ethnic minority and low-income groups should be prioritised. The vulnerability of low-income groups will likely be exacerbated further by the current energy supply and cost-of-living crises in many countries. It is therefore crucial that reassuring messaging highlighting the stability of suicide rates during the pandemic does not lead to complacency among policymakers.},
  pmcid = {PMC9579839},
  file = {/home/arosen/Zotero/storage/8A5J8TIE/Webb et al. - 2022 - Has the COVID-19 pandemic influenced suicide rates.pdf}
}

