@article{maruottiMixedHiddenMarkov2011,
  title = {Mixed Hidden Markov Models for Longitudinal Data: An Overview},
  shorttitle = {Mixed Hidden Markov Models for Longitudinal Data},
  author = {Maruotti, Antonello},
  date = {2011},
  journaltitle = {International Statistical Review},
  volume = {79},
