}

@article{zavorskyDebunkingGAMLSSMyth2025,
  title = {Debunking the {{GAMLSS}} Myth: {{Simplicity}} Reigns in Pulmonary Function Diagnostics},
  shorttitle = {Debunking the {{GAMLSS}} Myth},
  author = {Zavorsky, Gerald S.},
  date = {2025-01-01},
  journaltitle = {Respiratory Medicine},
  shortjournal = {Respiratory Medicine},
  volume = {236},
  pages = {107836},
  issn = {0954-6111},
  doi = {10.1016/j.rmed.2024.107836},
  url = {https://www.sciencedirect.com/science/article/pii/S0954611124003111},
  urldate = {2025-12-17},
  abstract = {Rationale Current technical standards advocate using Generalized, Additive Models of Location, Scale, and Shape (GAMLSS) for lung function reference equations. These equations are complicated and require supplementary spline tables. Objective (1) To demonstrate that segmented (piecewise) linear regression (SLR) yields prediction accuracies similar to GAMLSS in pulmonary function diagnostics. (2) To determine the agreement between both SLR and GAMLSS. Methods The NHANES 2007–2012 database was utilized to construct spirometric reference equations for FEV1, FVC, and FEV1/FVC using both SLR and GAMLSS modeling techniques. K-fold cross-validation was used to provide the 95\% confidence interval (CI) of the root-mean-square error (RMSE) as an indicator of prediction accuracy. Additionally, agreement was assessed between the two modeling techniques in classifying spirometric patterns (standard, airflow obstruction, restrictive, or mixed disorder) using an unweighted kappa statistic. Results The RMSE values for FEV1, FVC, and FEV1/FVC and correlation coefficients between predicted values and test data were similar between the two techniques. Agreement in classifying spirometric patterns between the two techniques ranged from 0.78 to 0.80 (95~\% CI). Conclusions The findings suggest that simple linear regression for FEV1/FVC and SLR for FEV1 and FVC offer prediction accuracies on par with GAMLSS while being more straightforward, parsimonious, and accessible to a broader audience in the field of pulmonary function diagnostics.},
  file = {/home/arosen/Zotero/storage/IE8CJFZC/Zavorsky - 2025 - Debunking the GAMLSS myth Simplicity reigns in pulmonary function diagnostics.pdf;/home/arosen/Zotero/storage/W3FIGVIK/S0954611124003111.html}
}

@article{zhangBayesianMixedHidden2014,
  title = {Bayesian {{Mixed Hidden Markov Models}}: {{A Multi-Level Approach}} to {{Modeling Categorical Outcomes}} with {{Differential Misclassification}}},
